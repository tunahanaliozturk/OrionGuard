{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "Moongazing.OrionGuard/Moongazing.OrionGuard.csproj",
            "Moongazing.OrionGuard.AspNetCore/Moongazing.OrionGuard.AspNetCore.csproj",
            "Moongazing.OrionGuard.Blazor/Moongazing.OrionGuard.Blazor.csproj",
            "Moongazing.OrionGuard.EntityFrameworkCore/Moongazing.OrionGuard.EntityFrameworkCore.csproj",
            "Moongazing.OrionGuard.Grpc/Moongazing.OrionGuard.Grpc.csproj",
            "Moongazing.OrionGuard.Hangfire/Moongazing.OrionGuard.Hangfire.csproj",
            "Moongazing.OrionGuard.Locks.Redis/Moongazing.OrionGuard.Locks.Redis.csproj",
            "Moongazing.OrionGuard.MassTransit/Moongazing.OrionGuard.MassTransit.csproj",
            "Moongazing.OrionGuard.MediatR/Moongazing.OrionGuard.MediatR.csproj",
            "Moongazing.OrionGuard.OpenTelemetry/Moongazing.OrionGuard.OpenTelemetry.csproj",
            "Moongazing.OrionGuard.Outbox.Dashboard/Moongazing.OrionGuard.Outbox.Dashboard.csproj",
            "Moongazing.OrionGuard.Outbox.PostgresNotify/Moongazing.OrionGuard.Outbox.PostgresNotify.csproj",
            "Moongazing.OrionGuard.Outbox.SqlServerBroker/Moongazing.OrionGuard.Outbox.SqlServerBroker.csproj",
            "Moongazing.OrionGuard.SignalR/Moongazing.OrionGuard.SignalR.csproj",
            "Moongazing.OrionGuard.Swagger/Moongazing.OrionGuard.Swagger.csproj",
            "Moongazing.OrionGuard.Testing/Moongazing.OrionGuard.Testing.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": { "TargetFramework": "net10.0" },
      "memberLayout": "separatePages",
      "namespaceLayout": "nested",
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      { "files": [ "api/**.yml", "api/index.md" ] },
      {
        "files": [ "*.md", "toc.yml", "docs/**.md", "docs/**/toc.yml", "packages/**.md", "packages/**/toc.yml" ],
        "exclude": [ "README.md" ]
      }
    ],
    "resource": [
      { "files": [ "logo.png" ], "src": "../docs", "dest": "images" },
      { "files": [ "**" ], "src": "playground/bin/publish/wwwroot", "dest": "playground" }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "OrionGuard",
      "_appTitle": "OrionGuard",
      "_appLogoPath": "images/logo.png",
      "_appFaviconPath": "images/logo.png",
      "_enableSearch": true,
      "_disableContribution": true,
      "pdf": false
    }
  }
}
