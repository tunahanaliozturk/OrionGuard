{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [ "*/*.csproj" ],
          "exclude": [
            "Moongazing.OrionGuard.Generators/**",
            "Moongazing.OrionGuard.OpenApi/**",
            "Moongazing.OrionGuard.Migration/**"
          ]
        }
      ],
      "dest": "api",
      "properties": { "TargetFramework": "net10.0" },
      "memberLayout": "separatePages",
      "namespaceLayout": "nested",
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      { "files": [ "api/**.yml", "api/index.md" ] },
      {
        "files": [ "*.md", "toc.yml", "docs/**.md", "docs/**/toc.yml", "packages/**.md", "packages/**/toc.yml" ],
        "exclude": [ "README.md" ]
      }
    ],
    "resource": [
      { "files": [ "logo.png" ], "src": "../docs", "dest": "images" },
      { "files": [ "**" ], "src": "playground/bin/publish/wwwroot", "dest": "playground" }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "OrionGuard",
      "_appTitle": "OrionGuard",
      "_appLogoPath": "images/logo.png",
      "_appFaviconPath": "images/logo.png",
      "_enableSearch": true,
      "_disableContribution": true,
      "pdf": false
    }
  }
}
