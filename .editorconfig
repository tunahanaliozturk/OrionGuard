# OrionGuard house style.
#
# This file describes what the code already does - it was written by measuring the tree, not by
# picking preferences. Where the codebase is unanimous the rule is a warning, so the analyzer
# catches the drift instead of a reviewer. Where the codebase is genuinely mixed the rule is a
# suggestion: an IDE hint, never a build failure, because turning it up would mean rewriting
# working code to satisfy a config file.
#
# Line endings are deliberately not set here: .gitattributes normalises them with `* text=auto`,
# so the working tree is CRLF on Windows and LF on Linux. Pinning end_of_line would make
# `dotnet format --verify-no-changes` fail on whichever platform lost the coin toss.
root = true

[*]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

# Markdown gives a hard line break with two trailing spaces, so trimming them changes the render.
[*.md]
trim_trailing_whitespace = false

[*.cs]

#### Formatting ####

# Allman braces: 3844 opening braces on their own line, none on the declaration line.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_between_query_expression_clauses = true

# Object and anonymous-type initializers are written several members to a line where the members
# form a row of test data. One member per line would turn those rows into columns and make the
# data harder to compare, so the formatter leaves them alone.
csharp_new_line_before_members_in_object_initializers = false
csharp_new_line_before_members_in_anonymous_types = false

csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = false
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_indent_block_contents = true
csharp_indent_braces = false

csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_parentheses = false
csharp_space_between_square_brackets = false
csharp_space_before_open_square_brackets = false
csharp_space_after_comma = true
csharp_space_before_comma = false
csharp_space_after_dot = false
csharp_space_before_dot = false
csharp_space_after_semicolon_in_for_statement = true
csharp_space_before_semicolon_in_for_statement = false

# 811 single-line statements: `if (value is null) return;`, `case '*': sb.Append("\2a"); break;`
# and the like. Splitting them would double the length of the guard surface and turn compact
# dispatch tables into pages of scrolling, for no gain.
csharp_preserve_single_line_statements = true
csharp_preserve_single_line_blocks = true

# The formatting rule is the one the whole tree already satisfies, so let it be enforced.
dotnet_diagnostic.IDE0055.severity = warning

#### using directives ####

# 135 files lead with System, 5 do not.
dotnet_separate_import_directive_groups = false
dotnet_sort_system_directives_first = true

# Genuinely split: 266 files put usings above the namespace, 54 below a file-scoped one. Stating
# the majority as a hint is honest; making it a warning would rewrite a fifth of the tree.
csharp_using_directive_placement = outside_namespace:suggestion

# An unused using is dead weight in a shipped package. Turned off below for the projects that
# consume the source generator: IDE0005 analyses the syntax tree before the generator runs, so a
# using that only serves a generated attribute such as [GenerateValidator] looks unused, and
# `dotnet format` will happily delete it and break the build.
dotnet_diagnostic.IDE0005.severity = warning

#### Language conventions ####

# File-scoped namespaces everywhere except the two netstandard2.0 Roslyn components, which are
# uniformly block-scoped. Left as a suggestion so a reformat is not forced on the source
# generators, where a careless edit changes what they emit.
csharp_style_namespace_declarations = file_scoped:suggestion

# 3203 `var` declarations. Preferred, not mandatory - the explicit-type cases are ones where the
# type is the point.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Expression bodies where they read better, blocks where they do not. Both are everywhere, so
# neither side is enforced.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = when_on_single_line:suggestion
csharp_style_expression_bodied_operators = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion

# Guard clauses are written `if (x is null) Throw();` on one line throughout the guard surface.
# Requiring braces would add noise to the hottest, most-read code in the library.
csharp_prefer_braces = true:silent

# Modern null and pattern syntax: 165 `is not null` against 21 `!= null`.
csharp_style_prefer_not_pattern = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion

csharp_style_prefer_null_check_over_type_check = true:suggestion

# Members are unqualified; `this.` appears 66 times in 5000+ members, always to disambiguate.
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Every member spells its accessibility out; `int` not `Int32`.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

dotnet_style_readonly_field = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_auto_properties = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
dotnet_style_prefer_conditional_expression_over_return = true:suggestion
dotnet_style_prefer_compound_assignment = true:suggestion
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion
dotnet_style_prefer_simplified_interpolation = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion
csharp_style_deconstructed_variable_declaration = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_prefer_static_local_function = true:suggestion
csharp_style_unused_value_assignment_preference = discard_variable:suggestion
csharp_style_unused_value_expression_statement_preference = discard_variable:silent

# IDE0290: use primary constructor. Off by an explicit team decision - the guard types assign
# constructor arguments to readonly fields and validate them on the way in, which a primary
# constructor cannot express.
csharp_style_prefer_primary_constructors = false

#### Naming ####
#
# Only the conventions the tree actually keeps are enforced. Two it does not keep, and which are
# therefore absent on purpose:
#   - private field casing is genuinely split (165 _underscore, 119 camelCase, 80 PascalCase
#     statics), so a rule here would just pick a side and rewrite the losers;
#   - test methods are named Method_Should_When (1252 of them against 73 plain), which is a
#     deliberate, readable convention that PascalCase would forbid. Method naming is therefore
#     enforced under src/ only, at the bottom of this file.

dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = prefixed_with_i
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.interface_symbols.applicable_accessibilities = *
dotnet_naming_style.prefixed_with_i.required_prefix = I
dotnet_naming_style.prefixed_with_i.capitalization = pascal_case

dotnet_naming_rule.types_and_members_are_pascal_case.severity = warning
dotnet_naming_rule.types_and_members_are_pascal_case.symbols = type_and_member_symbols
dotnet_naming_rule.types_and_members_are_pascal_case.style = pascal_case
dotnet_naming_symbols.type_and_member_symbols.applicable_kinds = class,struct,enum,delegate,property,event
dotnet_naming_symbols.type_and_member_symbols.applicable_accessibilities = *
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.constants_are_pascal_case.severity = warning
dotnet_naming_rule.constants_are_pascal_case.symbols = constant_symbols
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_symbols.constant_symbols.applicable_kinds = field
dotnet_naming_symbols.constant_symbols.applicable_accessibilities = *
dotnet_naming_symbols.constant_symbols.required_modifiers = const

#### Source-generator consumers ####

# The benchmarks and the demo reference OrionGuard.Generators as an analyzer and annotate their
# own types with generated attributes, which is the case IDE0005 gets wrong. See the note above.
# The generator test projects drive the generator through an in-memory compilation instead, so
# their usings mean what they say and stay checked.
[{benchmarks,demo}/**/*.cs]
dotnet_diagnostic.IDE0005.severity = none

#### Shipped code only ####

# No method under src/ has an underscore in its name; 1252 test methods do.
[src/**/*.cs]
dotnet_naming_rule.methods_are_pascal_case.severity = warning
dotnet_naming_rule.methods_are_pascal_case.symbols = method_symbols
dotnet_naming_rule.methods_are_pascal_case.style = pascal_case
dotnet_naming_symbols.method_symbols.applicable_kinds = method,local_function
dotnet_naming_symbols.method_symbols.applicable_accessibilities = *

# Source generators build C# as strings. The emitted text is data, and the layout of the file
# that produces it is load-bearing in a way the formatter cannot see.
[src/Moongazing.OrionGuard.Generators/**/*Emitter.cs]
dotnet_diagnostic.IDE0055.severity = none

[src/Moongazing.OrionGuard.OpenApi/Emit/*.cs]
dotnet_diagnostic.IDE0055.severity = none
