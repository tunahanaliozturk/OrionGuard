<Project>
  <!--
    Repo-wide settings every project inherits uniformly - tests, benchmarks, demo and templates
    included. The compiler settings and packaging metadata shared by the shipped packages live in
    src/Directory.Build.props, which imports this file; they are scoped there because a test or
    benchmark project must not inherit package metadata or the multi-targeting set.

    NuGetAuditMode=all audits the whole transitive dependency graph, not just direct references
    (the default), so a vulnerable transitive package is flagged at restore time. Advisories
    (NU1901-1904) are downgraded to warnings via WarningsNotAsErrors so a newly-disclosed
    upstream CVE surfaces loudly without turning CI red on an external event with no code
    change - remove that property to make advisories hard build errors instead. The NoWarn lines
    no longer suppress NU1901-1904, so the advisories are visible.
  -->
  <PropertyGroup>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!--
    PublishRepositoryUrl writes the repository URL and the commit (from Source Link) into every
    package's nuspec, so a package can be traced to the exact source it was built from. The release
    job adds ContinuousIntegrationBuild=true on the command line for reproducible paths; it is not
    set here so local and test builds keep their real source paths.
  -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
</Project>
