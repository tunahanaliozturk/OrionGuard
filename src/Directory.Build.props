<Project>

  <!--
    Everything under src/ is a shipped NuGet package, so the compiler settings and the packaging
    metadata are the same for all of them. They live here instead of being repeated in twenty-odd
    csproj files, where they drifted apart one copy-paste at a time.

    This file is scoped to src/ on purpose: tests, benchmarks, the demo, the docs playground and
    the template pack are not shipped libraries and must not inherit packaging metadata or the
    multi-targeting set. MSBuild stops at the first Directory.Build.props it finds walking up from
    a project, so the repo-wide one has to be imported by hand.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!--
      net8.0 and net9.0 are the supported LTS/STS runtimes; net10.0 is what the repo builds on.
      The three single-target projects (the two netstandard2.0 Roslyn components and the dotnet
      tool) clear this and set TargetFramework instead.
    -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Public API carries XML docs, so the docs have to end up in the package. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      CS1591: XML docs are required on public API but not on every internal or generated member.
      NU1900 is kept only for the private-feed-unreachable case (a transient restore read failure),
      NOT to silence vulnerability severities: NU1901-NU1904 (low/moderate/high/critical advisories)
      are deliberately NOT suppressed, so a vulnerable transitive package stays visible.
    -->
    <NoWarn>CS1591;NU1900</NoWarn>
  </PropertyGroup>

  <!--
    Package metadata shared by every shipped package. PackageId, Version, Description and
    PackageTags stay per-project: they are what makes one package different from the next.
    The <None Include="docs\..." Pack="true"/> items that back PackageReadmeFile and PackageIcon
    also stay per-project - moving them here would declare them ahead of the SDK's default item
    globs and trip NETSDK1022 duplicate-item errors.
  -->
  <PropertyGroup>
    <Authors>Tunahan Ali Ozturk</Authors>
    <PackageReadmeFile>docs/README.md</PackageReadmeFile>
    <PackageIcon>docs/logo.png</PackageIcon>
    <PackageProjectUrl>https://github.com/tunahanaliozturk/OrionGuard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tunahanaliozturk/OrionGuard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- The core package ships the licence as a file instead and clears this. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
