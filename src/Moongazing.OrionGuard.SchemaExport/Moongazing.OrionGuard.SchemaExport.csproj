<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>OrionGuard.SchemaExport</PackageId>
    <Version>7.0.0</Version>
    <Description>Exports the OrionGuard validation attributes on a model as a JSON Schema (draft 2020-12) document or a TypeScript interface, so a frontend consumes the rules instead of re-writing them by hand. Rules OrionGuard cannot express in the artifact are listed rather than dropped.</Description>
    <PackageTags>guard;validation;json-schema;typescript;codegen;schema;export;contract</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Moongazing.OrionGuard\Moongazing.OrionGuard.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="docs\README.md" Pack="true" PackagePath="docs/" />
    <None Include="docs\logo.png" Pack="true" PackagePath="docs/" />
  </ItemGroup>
</Project>
