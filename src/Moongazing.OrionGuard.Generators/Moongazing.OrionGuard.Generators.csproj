<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      A Roslyn component loads into the compiler, which runs on netstandard2.0 - so this project
      does not multi-target and clears the repo-wide set from src/Directory.Build.props. Implicit
      usings are off because netstandard2.0 has no implicit-using set to enable, and warnings are
      not errors here because the Roslyn analyzer packages warn about API surface the compiler
      host controls, not about this code.
    -->
    <TargetFrameworks />
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- No NU1900: this project restores nothing from a private feed. -->
    <NoWarn>CS1591</NoWarn>
    <PackageId>OrionGuard.Generators</PackageId>
    <Version>6.7.0</Version>
    <Description>Source generator for OrionGuard. Generates reflection-free, NativeAOT-compatible [GenerateValidator] validators and ships the OG0001 analyzer. The [StronglyTypedId&lt;TValue&gt;] generator is deprecated in favour of OrionKey and is removed in v7.0.0. Requires .NET SDK 10.0.400 or newer.</Description>
    <PackageTags>guard;validation;source-generator;roslyn;nativeaot;codegen;ddd;strongly-typed-id</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="docs\README.md" Pack="true" PackagePath="docs/" />
    <None Include="docs\logo.png" Pack="true" PackagePath="docs/" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
</Project>
