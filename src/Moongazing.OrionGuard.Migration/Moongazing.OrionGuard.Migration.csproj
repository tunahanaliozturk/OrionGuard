<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      A dotnet tool ships one executable, so it targets only the runtime it is built against and
      clears the repo-wide multi-targeting set from src/Directory.Build.props.
    -->
    <TargetFrameworks />
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Moongazing.OrionGuard.Migration</RootNamespace>
    <AssemblyName>Moongazing.OrionGuard.Migration</AssemblyName>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>orionguard</ToolCommandName>
    <PackageId>OrionGuard.Migration</PackageId>
    <Version>7.0.0</Version>
    <Company>Tunahan Ali Ozturk</Company>
    <Description>FluentValidation to OrionGuard migration codemod, packaged as a dotnet tool (dotnet orionguard migrate). Reads C# sources with Roslyn, finds AbstractValidator&lt;T&gt; classes, and rewrites their RuleFor chains onto the OrionGuard FluentStyleValidator compatibility surface. Reports anything it cannot safely migrate instead of guessing.</Description>
    <PackageTags>guard;validation;fluentvalidation;migration;codemod;roslyn;dotnet-tool;cli</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Moongazing.OrionGuard.Migration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="docs\README.md" Pack="true" PackagePath="docs/" />
    <None Include="docs\logo.png" Pack="true" PackagePath="docs/" />
  </ItemGroup>

</Project>
