<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <PackageId>OrionGuard.Blazor</PackageId>
    <Version>7.0.0</Version>
    <Description>Blazor integration for OrionGuard validation library. Provides EditForm validation components that run OrionGuard attribute rules or a registered IValidator&lt;TModel&gt;.</Description>
    <PackageTags>guard;validation;blazor;editform;component;wasm;server</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Moongazing.OrionGuard\Moongazing.OrionGuard.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="docs\README.md" Pack="true" PackagePath="docs/" />
    <None Include="docs\logo.png" Pack="true" PackagePath="docs/" />
  </ItemGroup>
</Project>
