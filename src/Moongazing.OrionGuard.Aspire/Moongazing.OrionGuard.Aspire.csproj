<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>OrionGuard.Aspire</PackageId>
    <Version>7.0.0</Version>
    <Description>Aspire integration for OrionGuard. One call, builder.AddOrionGuardDefaults(), subscribes the app's OpenTelemetry pipeline to every OrionGuard meter and activity source (validation, domain events, EF Core outbox) so they appear in the Aspire dashboard, and registers the OrionGuard health checks for the packages the app uses.</Description>
    <PackageTags>guard;validation;aspire;opentelemetry;metrics;tracing;health-checks;observability</PackageTags>
  </PropertyGroup>

  <!--
    No Aspire package: the dashboard only consumes OTLP, which the app's own OpenTelemetry setup
    exports. OpenTelemetry.Api.ProviderBuilderExtensions is the OpenTelemetry package meant for
    libraries: it adds meters and sources to the app's providers without pulling in the SDK.
    OrionGuard.AspNetCore and OrionGuard.EntityFrameworkCore are deliberately not referenced, so an
    app that uses neither does not get ASP.NET Core or EF Core; their health checks are found at runtime.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.19.0" />
    <ProjectReference Include="..\Moongazing.OrionGuard.OpenTelemetry\Moongazing.OrionGuard.OpenTelemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="docs\README.md" Pack="true" PackagePath="docs/" />
    <None Include="docs\logo.png" Pack="true" PackagePath="docs/" />
  </ItemGroup>
</Project>
