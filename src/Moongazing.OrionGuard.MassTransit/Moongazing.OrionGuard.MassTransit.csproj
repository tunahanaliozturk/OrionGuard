<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>OrionGuard.MassTransit</PackageId>
    <Version>6.7.0</Version>
    <Description>MassTransit integration for OrionGuard validation library. Provides a scoped consume filter that validates every consumed message with its registered validators, so an invalid message faults before it reaches the consumer.</Description>
    <PackageTags>guard;validation;masstransit;messaging;consume-filter;middleware</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Pinned to MassTransit 8.x on purpose. 8.5.10 is the latest Apache-2.0 release; MassTransit v9 moved
      to a commercial license, so referencing it would force that license on every consumer of this
      package. Consumers can still resolve any later 8.x release.
    -->
    <PackageReference Include="MassTransit" Version="[8.5.10,9.0.0)" />
    <ProjectReference Include="..\Moongazing.OrionGuard\Moongazing.OrionGuard.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="docs\README.md" Pack="true" PackagePath="docs/" />
    <None Include="docs\logo.png" Pack="true" PackagePath="docs/" />
  </ItemGroup>
</Project>
