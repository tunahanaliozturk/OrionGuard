<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>OrionGuard.Testing</PackageId>
    <Version>7.0.0</Version>
    <Description>Testing helpers for OrionGuard. Provides DomainEventCapture and InMemoryDomainEventDispatcher for domain events, plus OrionGuardSnapshot (pin a validator's rules to a .verified.txt file) and OrionGuardCoverage (fail when a model property carries no rule), with framework-agnostic assertions (no xUnit / NUnit / FluentAssertions / Verify dependency). Works with any test runner.</Description>
    <PackageTags>guard;validation;testing;ddd;domain-events;assertions;test-helpers;snapshot-testing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moongazing.OrionGuard\Moongazing.OrionGuard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="docs\README.md" Pack="true" PackagePath="docs/" />
    <None Include="docs\logo.png" Pack="true" PackagePath="docs/" />
  </ItemGroup>
</Project>
